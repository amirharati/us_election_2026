/.codex/
# Local environments, Python/Jupyter caches, and editor/OS scratch files.
.venv/
venv/
__pycache__/
*.py[cod]
*.nbc
*.nbi
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.DS_Store
*.swp
*.swo
*.tmp

# Local source checks, preparation pointers, inference caches, and logs.
/cache/
# Historical market research is reproducible downloaded/generated data.
# Keep scripts, configuration, notebooks, and Markdown/image reports in Git.
/outputs/results/research/polymarket_history/
/outputs/results/research/senate_archive/
/outputs/reports/**/polymarket_history/*.parquet
/outputs/reports/**/senate_archive/*.parquet
/outputs/reports/**/polymarket_history/*.json*
/outputs/reports/**/senate_archive/*.json*
/data/final_work/
/data/**/latest.json

# Raw archives and legacy preparation trees are optional local ingestion/audit data.
# The self-contained compact historical/current model inputs are ordinary Git files.
/data/*
!/data/compact/
/data/compact/*
!/data/compact/frozen/
!/data/compact/current/

# Notebook execution logs and local reproducibility scratch.
/outputs/validation/*.log
/outputs/results/**/.publish-*/
/outputs/reports/**/.publish-*/

# Canonical report bundles live under outputs/reports; these old duplicate copies
# remain available locally but are never uploaded again.
/outputs/results/forecast/live_reports/
/outputs/results/markets/

# Optional legacy row-level audit exports; compact inputs and audit summaries stay.
/reports/data_review/survey_identity_identity.csv
/reports/data_review/basis_availability_metadata.csv
